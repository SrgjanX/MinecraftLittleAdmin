<Window x:Class="MinecraftLittleAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft Little Admin"
        Width="880" Height="760" MinWidth="640" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4FC3F7" Offset="0" />
            <GradientStop Color="#B3E5FC" Offset="0.75" />
            <GradientStop Color="#7CB342" Offset="0.75" />
            <GradientStop Color="#558B2F" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Minecraft Little Admin" HorizontalAlignment="Center"
                   FontFamily="{StaticResource KidFont}" FontSize="32" Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="3" BlurRadius="6" Opacity="0.6" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- Connection panel (for grown-ups) -->
        <Border Grid.Row="1" Margin="14,12,14,4" Padding="16,12" CornerRadius="20" Background="#E6FFFFFF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="StatusPill" Grid.Column="0" CornerRadius="16" Padding="16,8"
                        VerticalAlignment="Center" Background="#E53935">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="14" Height="14" Fill="White" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Not connected" Margin="8,0,0,0"
                                   Foreground="White" FontFamily="Segoe UI Black" FontSize="18" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="HelpPanel" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConnectButton" Content="Connect to Minecraft" Padding="22,10"
                                Style="{StaticResource SmallButton}" Background="#FFD54F"
                                FontFamily="{StaticResource KidFont}" FontSize="20"
                                Click="ConnectButton_Click" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#1E3A5F"
                                   FontFamily="Segoe UI Semibold" FontSize="14" TextWrapping="Wrap"
                                   Text="Open your world first, then press the button." />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Foreground="#4A6278" FontSize="12" TextWrapping="Wrap">
                        <Run Text="The world needs cheats turned on. You can also type" />
                        <Run x:Name="ConnectCommandText" FontFamily="Consolas" FontWeight="Bold" />
                        <Run Text="in Minecraft chat yourself." />
                    </TextBlock>
                </StackPanel>

                <TextBlock x:Name="ConnectedHint" Grid.Column="1" Margin="18,0,0,0" Visibility="Collapsed"
                           VerticalAlignment="Center" Foreground="#2E7D32" FontFamily="{StaticResource KidFont}"
                           FontSize="20" Text="Minecraft is connected! Tap a button below." />
            </Grid>
        </Border>

        <!-- The big buttons -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="2">
                <!-- ☀️ Day -->
                <Button x:Name="DayButton" Style="{StaticResource BigButton}" Background="#FFB300"
                        Tag="time set day" Click="WorldButton_Click">
                    <StackPanel>
                        <Viewbox Width="64" Height="64">
                            <Canvas Width="100" Height="100">
                                <Path Stroke="#FFF59D" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M50,4 L50,16 M50,84 L50,96 M4,50 L16,50 M84,50 L96,50 M17,17 L26,26 M74,74 L83,83 M17,83 L26,74 M74,26 L83,17" />
                                <Ellipse Canvas.Left="24" Canvas.Top="24" Width="52" Height="52" Fill="#FFEB3B"
                                         Stroke="#FFF9C4" StrokeThickness="4" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Day" Style="{StaticResource ButtonLabel}" />
                    </StackPanel>
                </Button>

                <!-- 🌙 Night -->
                <Button x:Name="NightButton" Style="{StaticResource BigButton}" Background="#3949AB"
                        Tag="time set night" Click="WorldButton_Click">
                    <StackPanel>
                        <Viewbox Width="64" Height="64">
                            <Canvas Width="100" Height="100">
                                <Path Fill="#FFF59D">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <EllipseGeometry Center="46,52" RadiusX="36" RadiusY="36" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <EllipseGeometry Center="64,40" RadiusX="30" RadiusY="30" />
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                </Path>
                                <Path Fill="White" Data="M80,62 L83,70 L91,73 L83,76 L80,84 L77,76 L69,73 L77,70 Z" />
                                <Path Fill="White" Data="M70,8 L72,14 L78,16 L72,18 L70,24 L68,18 L62,16 L68,14 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Night" Style="{StaticResource ButtonLabel}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <UniformGrid Grid.Row="1" Columns="3">
                <!-- 🌧️ Rain -->
                <Button x:Name="RainButton" Style="{StaticResource BigButton}" Background="#1E88E5"
                        Tag="weather rain" Click="WorldButton_Click">
                    <StackPanel>
                        <Viewbox Width="64" Height="64">
                            <Canvas Width="100" Height="100">
                                <Path Fill="#ECEFF1" Data="{StaticResource CloudGeometry}" />
                                <Path Stroke="#81D4FA" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M32,74 L27,90 M52,74 L47,90 M72,74 L67,90" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Rain" Style="{StaticResource ButtonLabel}" />
                    </StackPanel>
                </Button>

                <!-- 🚫🌧️ No Rain -->
                <Button x:Name="ClearButton" Style="{StaticResource BigButton}" Background="#43A047"
                        Tag="weather clear" Click="WorldButton_Click">
                    <StackPanel>
                        <Viewbox Width="64" Height="64">
                            <Canvas Width="100" Height="100">
                                <Path Fill="#ECEFF1" Data="{StaticResource CloudGeometry}" />
                                <Path Stroke="#81D4FA" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M32,74 L27,90 M52,74 L47,90 M72,74 L67,90" />
                                <Ellipse Canvas.Left="6" Canvas.Top="6" Width="88" Height="88"
                                         Stroke="#E53935" StrokeThickness="9" />
                                <Line X1="19" Y1="19" X2="81" Y2="81" Stroke="#E53935" StrokeThickness="9" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="No Rain" Style="{StaticResource ButtonLabel}" />
                    </StackPanel>
                </Button>

                <!-- ⛈️ Storm -->
                <Button x:Name="StormButton" Style="{StaticResource BigButton}" Background="#5E35B1"
                        Tag="weather thunder" Click="WorldButton_Click">
                    <StackPanel>
                        <Viewbox Width="64" Height="64">
                            <Canvas Width="100" Height="100">
                                <Path Fill="#90A4AE" Data="{StaticResource CloudGeometry}" />
                                <Path Fill="#FFEB3B" Stroke="#FFF59D" StrokeThickness="2" StrokeLineJoin="Round"
                                      Data="M56,56 L40,80 L51,80 L43,98 L66,70 L55,70 L63,56 Z" />
                                <Path Stroke="#81D4FA" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M28,74 L24,88 M78,74 L74,88" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Storm" Style="{StaticResource ButtonLabel}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <UniformGrid Grid.Row="2" Columns="2">
                <!-- ⚔️ Survival -->
                <Button x:Name="SurvivalButton" Style="{StaticResource BigButton}" Background="#E53935"
                        Tag="gamemode survival @s" Click="WorldButton_Click">
                    <StackPanel>
                        <Viewbox Width="64" Height="64">
                            <Canvas Width="100" Height="100">
                                <Path Fill="#ECEFF1" Stroke="#B0BEC5" StrokeThickness="3" StrokeLineJoin="Round"
                                      Data="M88,12 L84,30 L40,74 L26,60 L70,16 Z" />
                                <Line X1="18" Y1="54" X2="46" Y2="82" Stroke="#8D6E63" StrokeThickness="10"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="31" Y1="69" X2="16" Y2="84" Stroke="#5D4037" StrokeThickness="9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="7" Canvas.Top="83" Width="14" Height="14" Fill="#FFD54F" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Survival" Style="{StaticResource ButtonLabel}" />
                    </StackPanel>
                </Button>

                <!-- 🧱 Creative -->
                <Button x:Name="CreativeButton" Style="{StaticResource BigButton}" Background="#00897B"
                        Tag="gamemode creative @s" Click="WorldButton_Click">
                    <StackPanel>
                        <Viewbox Width="64" Height="64">
                            <Canvas Width="100" Height="100">
                                <Path Fill="#8D6E63" Data="M12,30 L50,50 L50,92 L12,72 Z" />
                                <Path Fill="#6D4C41" Data="M88,30 L50,50 L50,92 L88,72 Z" />
                                <Path Fill="#689F38" Data="M12,30 L50,50 L50,60 L12,40 Z" />
                                <Path Fill="#558B2F" Data="M88,30 L50,50 L50,60 L88,40 Z" />
                                <Path Fill="#9CCC65" Stroke="#C5E1A5" StrokeThickness="2" StrokeLineJoin="Round"
                                      Data="M50,10 L88,30 L50,50 L12,30 Z" />
                                <Path Fill="White" Data="M84,58 L87,66 L95,69 L87,72 L84,80 L81,72 L73,69 L81,66 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Creative" Style="{StaticResource ButtonLabel}" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>

        <!-- Friendly feedback -->
        <Border x:Name="FeedbackBubble" Grid.Row="3" Margin="14,4,14,0" Padding="18,10" CornerRadius="18"
                Background="#E6FFFFFF" HorizontalAlignment="Center" Opacity="0">
            <TextBlock x:Name="FeedbackText" FontFamily="{StaticResource KidFont}" FontSize="22"
                       Foreground="#1E3A5F" TextAlignment="Center" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
